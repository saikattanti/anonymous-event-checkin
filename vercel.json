{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "checkin-ui/dist",
  "rewrites": [
    {
      "source": "/proof-server/:path*",
      "destination": "https://proof-server.preprod.midnight.network/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
