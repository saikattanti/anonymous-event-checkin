# Frontend configuration for the Anonymous Event Check-in DApp.
# Copy to `.env.local` and edit. All values are read at build/dev time by Vite.

# Which Midnight network the deployed contract lives on.
# One of: undeployed | preview | preprod
VITE_MIDNIGHT_NETWORK=undeployed

# Address of the deployed Anonymous Event Check-in contract.
# Get this from `.midnight-state.json` -> deployments.<network>.address
# after running `npm run setup` (local) or `npm run setup -- --network preprod`.
VITE_CONTRACT_ADDRESS=

# --- Optional service endpoint overrides ---------------------------------
# When connected to Lace, the wallet supplies indexer/prover/node URIs via
# its serviceUriConfig(). The values below override those (handy for local
# devnet, where the wallet may not know your localhost services).
#
# Local devnet defaults (docker-compose.yml):
#   VITE_INDEXER_URI=http://127.0.0.1:8088/api/v4/graphql
#   VITE_INDEXER_WS_URI=ws://127.0.0.1:8088/api/v4/graphql/ws
#   VITE_PROVER_URI=http://127.0.0.1:6300
VITE_INDEXER_URI=
VITE_INDEXER_WS_URI=
VITE_PROVER_URI=
